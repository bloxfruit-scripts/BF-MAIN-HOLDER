-- Check if current game is Blox Fruit
local function isBloxFruitGame()
    local placeId = game.PlaceId
    local bloxFruitPlaceIds = {
        -- Main game places
        [2753915549] = true, -- 1st Sea
        [4442272183] = true, -- 2nd Sea
        [7449423635] = true, -- 3rd Sea
        [3741319573] = true, -- Private Server? (Testing)
        [6299805723] = true, -- Update 17
        [6403373529] = true, -- Update 17.3
        [8579829132] = true, -- Update 20
    }
    return bloxFruitPlaceIds[placeId] or false
end

-- Check which sea the player is in
local function getCurrentSea()
    local placeId = game.PlaceId
    if placeId == 2753915549 then
        return 1
    elseif placeId == 4442272183 then
        return 2
    elseif placeId == 7449423635 or placeId == 3741319573 or placeId == 6299805723 or placeId == 6403373529 or placeId == 8579829132 then
        return 3
    else
        return 0 -- Unknown/Other
    end
end

-- Check if player is in a private server
local function isPrivateServer()
    -- Check if the game instance is a private server
    local privateServerId = game.PrivateServerId
    local vipServerId = game.VIPServerId
    return privateServerId ~= nil and privateServerId ~= "" or vipServerId ~= nil and vipServerId ~= ""
end

