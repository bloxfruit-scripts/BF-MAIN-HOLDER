-- Variable to store the loaded script environment
local loadedScriptEnv = nil

-- Function to safely load script with retry
local function loadScriptWithRetry(url, maxRetries)
    maxRetries = maxRetries or 3
    
    for attempt = 1, maxRetries do
        local success, result = pcall(function()
            -- Add a small delay between retries
            if attempt > 1 then wait(1) end
            
            -- Try to get the script content
            local content = game:HttpGet(url)
            
            -- Check if content is valid
            if not content or #content < 10 then
                error("Script content is empty or too short")
            end
            
            -- Try to load the script
            local func = loadstring(content)
            if not func then
                error("Failed to compile script - invalid Lua code")
            end
            
            -- Execute the script and store its return value
            return func()
        end)
        
        if success then
            print("✅ Script loaded successfully on attempt", attempt)
            return true, result
        else
            print("⚠️ Script loading attempt", attempt, "failed:", tostring(result))
        end
    end
    
    return false, "All loading attempts failed"
end

-- Main execution flow
local function startMainFlow()
    -- GUI 1 (Main Verification)
    local gui1, button1 = createMainVerificationGUI()
    
    button1.MouseButton1Click:Connect(function()
        gui1:Destroy()
        wait(0.1)
        
        -- GUI 2 (Remember Screen)
        local gui2, statusText, spinner = createRememberGUI()
        
        -- Status updates sequence
        wait(1)
        statusText.Text = "LOADING SCRIPT... (15s)"
        wait(5)
        statusText.Text = "BYPASSING SERVER..."
        wait(5)
        statusText.Text = "FINALIZING..."
        wait(5)
        statusText.Text = "EXECUTING SCRIPT..."
        
        -- Load the actual script from URL with retry
        local success, result = loadScriptWithRetry(SCRIPT_URL, 3)
        
        if success then
            statusText.Text = "✅ SCRIPT LOADED SUCCESSFULLY!"
            statusText.TextColor3 = COLORS.Success
            loadedScriptEnv = result
            wait(2)
            gui2:Destroy()
            
            -- Corner Alert
            createCornerAlert()
            
            -- Wait 12 minutes (720 seconds) - NO VISUAL INDICATOR
            wait(720)
            
            -- Show key system GUI at the end (on top of everything)
            if LOADING_GUI == "ON" then
                -- Create and show key system with HIGH DisplayOrder
                local keyGui, keyBox, submitBtn, getKeyBtn, linkBox, statusLabel = createKeyGUI()
                
                local function checkKey()
                    if keyBox.Text == CORRECT_KEY then
                        statusLabel.Text = "✅ KEY ACCEPTED!"
                        statusLabel.TextColor3 = COLORS.Success
                        wait(1)
                        keyGui:Destroy()
                        
                        -- Show final kick message and kick player
                        local kickGui = createFinalKickGUI()
                        wait(3)
                        kickGui:Destroy()
                        
                        -- Kick player with the message
                        player:Kick("THE SCRIPT GOT MANY ERRORS\nPLEASE TRY THIS SCRIPT LATER")
                    else
                        statusLabel.Text = "❌ INVALID KEY! TRY AGAIN"
                        statusLabel.TextColor3 = COLORS.Warning
                    end
                end
                
                submitBtn.MouseButton1Click:Connect(checkKey)
                
                keyBox.FocusLost:Connect(function(enter)
                    if enter then
                        checkKey()
                    end
                end)
                
                getKeyBtn.MouseButton1Click:Connect(function()
                    linkBox.Visible = not linkBox.Visible
                    if linkBox.Visible then
                        getKeyBtn.Text = "HIDE LINK"
                        getKeyBtn.BackgroundColor3 = COLORS.Primary
                    else
                        getKeyBtn.Text = "GET KEY"
                        getKeyBtn.BackgroundColor3 = COLORS.SecondaryLight
                    end
                end)
            end
            
        else
            statusText.Text = "❌ SCRIPT LOADING FAILED!"
            statusText.TextColor3 = COLORS.Warning
            wait(3)
            gui2:Destroy()
            
            -- Show error message
            local errorGui = Instance.new("ScreenGui")
            errorGui.Parent = PlayerGui
            errorGui.DisplayOrder = 9999
            errorGui.Name = "DrixError"
            errorGui.IgnoreGuiInset = true
            
            local errorFrame = Instance.new("Frame")
            errorFrame.Size = UDim2.new(0, 400, 0, 200)
            errorFrame.Position = UDim2.new(0.5, -200, 0.5, -100)
            errorFrame.BackgroundColor3 = COLORS.DarkRed
            errorFrame.BackgroundTransparency = 0
            errorFrame.BorderSizePixel = 0
            errorFrame.Parent = errorGui
            
            local errorCorner = Instance.new("UICorner")
            errorCorner.CornerRadius = UDim.new(0, 20)
            errorCorner.Parent = errorFrame
            
            local errorText = Instance.new("TextLabel")
            errorText.Size = UDim2.new(0.9, 0, 0.8, 0)
            errorText.Position = UDim2.new(0.05, 0, 0.1, 0)
            errorText.BackgroundTransparency = 1
            errorText.Text = "⚠️ SCRIPT LOADING FAILED!\n\nThe script URL may be invalid or blocked.\nPlease check your internet connection and try again."
            errorText.Font = Enum.Font.GothamBold
            errorText.TextSize = 20
            errorText.TextColor3 = COLORS.Text
            errorText.TextWrapped = true
            errorText.Parent = errorFrame
            
            wait(5)
            errorGui:Destroy()
        end
    end)
end

-- Initialize based on LOADING_GUI setting
local function init()
    if LOADING_GUI == "ON" then
        startMainFlow()
    elseif LOADING_GUI == "OFF" then
        print("LOADING_GUI is OFF - Starting main flow")
        startMainFlow()
    else
        warn("LOADING_GUI must be set to 'ON' or 'OFF'. Defaulting to 'ON'.")
        LOADING_GUI = "ON"
        init()
    end
end

-- Start the script
init()
